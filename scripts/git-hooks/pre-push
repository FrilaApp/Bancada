#!/bin/bash
# Bloqueia git push até que a identidade do autor seja confirmada biometricamente.
# Existe para que nada saia desta máquina sem uma pessoa presente — inclusive
# quando um agente estiver conduzindo o trabalho.
#
# Escape emergencial / CI: SKIP_BIOMETRICS=1 git push
set -euo pipefail

[ -n "${SKIP_BIOMETRICS:-}" ] && exit 0

raiz="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "❌ Push abortado: não consegui localizar a raiz do repositório." >&2
  exit 1
}

# Compila sob demanda caso o binário ainda não exista nesta máquina.
if [ ! -x "$raiz/scripts/auth-touchid" ]; then
  if command -v swiftc >/dev/null 2>&1 && [ -f "$raiz/scripts/auth-touchid.swift" ]; then
    swiftc "$raiz/scripts/auth-touchid.swift" -o "$raiz/scripts/auth-touchid" 2>/dev/null || true
    chmod +x "$raiz/scripts/auth-touchid" 2>/dev/null || true
  fi
fi

# Falha fechado: sem o módulo, o push não sai. Um gate que passa em silêncio
# é pior que gate nenhum, porque cria confiança falsa.
if [ ! -x "$raiz/scripts/auth-touchid" ]; then
  cat >&2 <<'MSG'
❌ Push abortado: o módulo de autenticação não está disponível nesta máquina.

Este repositório exige confirmação de identidade antes de publicar.
Para habilitar aqui:

  xcode-select --install     # instala o swiftc, se estiver faltando
  ./scripts/bootstrap.sh     # compila o módulo

Se você precisa publicar agora e sabe o que está fazendo:

  SKIP_BIOMETRICS=1 git push
MSG
  exit 1
fi

# Camada opcional: quem tiver o ActionShelf (app pessoal do fbtostadev, fora
# deste repositório) usa a interface dele em vez do prompt padrão do sistema.
# Para os outros colaboradores, "$actionshelf_bin" nunca existe, o bloco abaixo
# não roda, e o fluxo cai direto no Touch ID padrão logo em seguida — ninguém
# mais precisa deste projeto para publicar.
# Prioridade 1: Action Shelf na Notch (Mini-App com física de molas)
actionshelf_bin="$raiz/../ActionShelf/ActionShelf"
if [ ! -x "$actionshelf_bin" ] && [ -f "$raiz/../ActionShelf/build.sh" ]; then
  "$raiz/../ActionShelf/build.sh" >/dev/null 2>&1 || true
fi

if [ -x "$actionshelf_bin" ]; then
  echo "🔐 Exibindo Action Shelf na Notch (Touch ID / macOS)…"
  if ! "$actionshelf_bin" --reason "Autorizar o envio de alterações (git push) no Challenge 18"; then
    echo "❌ Autenticação cancelada ou não autorizada. O push foi abortado." >&2
    exit 1
  fi
  echo "  ✓ Identidade confirmada pela Action Shelf."
  exit 0
fi

echo "🔐 Solicitando autenticação (Touch ID, Apple Watch ou senha do macOS)…"
if ! "$raiz/scripts/auth-touchid"; then
  echo "❌ Autenticação cancelada ou não autorizada. O push foi abortado." >&2
  exit 1
fi
echo "  ✓ Identidade confirmada."
exit 0
