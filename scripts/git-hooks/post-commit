#!/bin/bash
# Registra o commit recém-criado no log de fatos do dia.
# Nunca pode falhar o commit — o commit já aconteceu neste ponto.
#
# O fato sobre o commit X só pode existir depois que X já aconteceu, então
# registrá-lo sempre deixa o arquivo do dia "sujo" logo após todo commit. Sem
# tratar isso, o log fica pendente para sempre, um passo atrás de si mesmo —
# e isso trava `git pull --rebase` (e até `git merge`) de qualquer colaborador.
# A saída é publicar o próprio registro num commit auxiliar automático, para o
# working tree voltar limpo assim que o hook termina.
#
# DOC_HARNESS_POST_COMMIT_LOCK evita a recursão óbvia: o `git commit` abaixo
# dispara este mesmo hook de novo, para o commit auxiliar.
[ -n "${DOC_HARNESS_POST_COMMIT_LOCK:-}" ] && exit 0

raiz="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
# shellcheck source=../lib.sh
source "$raiz/scripts/lib.sh"

"$raiz/scripts/registrar-fato.sh" commit >/dev/null 2>&1 || exit 0

log="$(caminho_log)"
if ! git -C "$raiz" diff --quiet -- "$log" 2>/dev/null; then
  git -C "$raiz" add "$log"
  DOC_HARNESS_POST_COMMIT_LOCK=1 git -C "$raiz" commit -q --no-verify \
    -m "Registra o commit anterior no log de fatos" >/dev/null 2>&1 || true
fi
exit 0
